rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Profil privé : adresse et coordonnées sont accessibles uniquement à la personne.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && !('email' in request.resource.data);
    }

    // Profil de communauté : liste blanche stricte, sans e-mail ni localisation.
    match /publicProfiles/{userId} {
      function isOwner() { return signedIn() && request.auth.uid == userId; }
      function validPublicProfile() {
        let data = request.resource.data;
        return data.keys().hasOnly(['firstName', 'lastName', 'photoUrl', 'bio', 'interests'])
          && data.keys().hasAll(['firstName', 'lastName', 'photoUrl', 'bio', 'interests'])
          && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 60
          && data.lastName is string && data.lastName.size() <= 80
          && data.photoUrl is string && data.photoUrl.size() <= 750000
          && data.bio is string && data.bio.size() <= 160
          && data.interests is list && data.interests.size() <= 12;
      }
      allow read: if signedIn();
      allow create, update: if isOwner() && validPublicProfile();
      allow delete: if isOwner();
    }

    // US-03 à US-10 : activités.
    match /activities/{activityId} {
      function isOrganizer() { return resource.data.organizerId == request.auth.uid; }
      function isMember() { return isOrganizer() || request.auth.uid in resource.data.participantIds; }
      function validActivity(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 60
          && data.description is string && data.description.size() <= 500
          && data.capacity is int && data.capacity >= 2 && data.capacity <= 100
          && data.participantIds is list && data.participantIds.size() <= data.capacity;
      }
      // Inscription ou désinscription : un membre n'ajoute ou ne retire que lui-même,
      // sans dépasser la capacité.
      function joinsOrLeaves() {
        let before = resource.data.participantIds;
        let after = request.resource.data.participantIds;
        return changed().hasOnly(['participantIds', 'updatedAtMs'])
          && after.size() <= resource.data.capacity
          && ((after.size() == before.size() + 1 && after.hasAll(before) && request.auth.uid in after && !(request.auth.uid in before))
            || (after.size() == before.size() - 1 && before.hasAll(after) && request.auth.uid in before && !(request.auth.uid in after)));
      }

      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid && validActivity(request.resource.data);
      allow update: if signedIn() && (
        (isOrganizer() && request.resource.data.organizerId == resource.data.organizerId && validActivity(request.resource.data))
        || joinsOrLeaves()
        || (isMember() && changed().hasOnly(['lastMessage']))
      );
      allow delete: if signedIn() && isOrganizer();

      // US-11/12 : groupe de discussion de l'activité, réservé à ses membres.
      match /messages/{messageId} {
        function activity() { return get(/databases/$(database)/documents/activities/$(activityId)).data; }
        function inGroup() { return activity().organizerId == request.auth.uid || request.auth.uid in activity().participantIds; }
        allow read: if signedIn() && inGroup();
        allow create: if signedIn() && inGroup()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      }
    }

    // Verrouillé par défaut — à ouvrir progressivement par collection
    // au fur et à mesure des User Stories (voir /specs/user-stories).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
