rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // US-01/02/13/14 : un membre connecté lit les profils (communauté, participants)
    // et ne crée ou ne modifie que le sien (y compris ses favoris).
    // RGPD : un profil étant lisible en entier, il ne doit jamais contenir l'e-mail
    // (conservé uniquement dans Firebase Authentication).
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId && !('email' in request.resource.data);
    }

    // US-03 à US-10 : activités.
    match /activities/{activityId} {
      function isOrganizer() { return resource.data.organizerId == request.auth.uid; }
      function isMember() { return isOrganizer() || request.auth.uid in resource.data.participantIds; }
      function validActivity(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 60
          && data.description is string && data.description.size() <= 500
          && data.capacity is int && data.capacity >= 2 && data.capacity <= 100
          && data.participantIds is list && data.participantIds.size() <= data.capacity;
      }
      // Inscription, désinscription et liste d'attente (sujet ART).
      // Chaque membre n'ajoute ou ne retire que lui-même ; une place libérée est
      // proposée au premier de la file, qui a au plus 24 h pour confirmer.
      function now() { return request.time.toMillis(); }
      function bp() { return resource.data.participantIds; }
      function ap() { return request.resource.data.participantIds; }
      function bw() { return resource.data.get('waitlistIds', []); }
      function aw() { return request.resource.data.get('waitlistIds', []); }
      function bo() { return resource.data.get('offer', null); }
      function ao() { return request.resource.data.get('offer', null); }
      function me() { return request.auth.uid; }
      function offerLive(o) { return o != null && o.expiresAtMs > now(); }
      function sameQueue() { return aw() == bw() && ao() == bo(); }
      function adds(before, after) { return after.size() == before.size() + 1 && after.hasAll(before) && me() in after && !(me() in before); }
      function removes(before, after) { return after.size() == before.size() - 1 && before.hasAll(after) && me() in before && !(me() in after); }
      // La place libre passe au premier de la file (ou l'offre est retirée si personne n'attend).
      function promotes(participants) {
        return (ao() == null && aw() == bw() && (bw().size() == 0 || participants.size() >= resource.data.capacity))
          || (bw().size() > 0 && participants.size() < resource.data.capacity
            && ao().keys().hasOnly(['uid', 'expiresAtMs', 'offeredAtMs']) && ao().uid == bw()[0]
            && ao().expiresAtMs is int && ao().expiresAtMs <= now() + 86460000
            && aw() == bw()[1:bw().size()]);
      }
      function joins() { return adds(bp(), ap()) && sameQueue() && bw().size() == 0 && ap().size() + (offerLive(bo()) ? 1 : 0) <= resource.data.capacity; }
      function leaves() { return removes(bp(), ap()) && (sameQueue() || (!offerLive(bo()) && promotes(ap()))); }
      function waits() { return ap() == bp() && ao() == bo() && !(me() in bp()) && (bo() == null || bo().uid != me()) && !(me() in bw()) && aw() == bw().concat([me()]); }
      function stopsWaiting() { return ap() == bp() && ao() == bo() && me() in bw() && aw() == bw().removeAll([me()]); }
      function accepts() { return bo() != null && bo().uid == me() && offerLive(bo()) && adds(bp(), ap()) && promotes(ap()); }
      function declines() { return bo() != null && bo().uid == me() && ap() == bp() && promotes(ap()); }
      function refreshes() { return !offerLive(bo()) && ap() == bp() && promotes(ap()); }
      function queueUpdate() {
        return changed().hasOnly(['participantIds', 'waitlistIds', 'offer', 'updatedAtMs'])
          && ap().size() <= resource.data.capacity
          && (joins() || leaves() || waits() || stopsWaiting() || accepts() || declines() || refreshes());
      }

      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid && validActivity(request.resource.data);
      allow update: if signedIn() && (
        (isOrganizer() && request.resource.data.organizerId == resource.data.organizerId && validActivity(request.resource.data))
        || queueUpdate()
        || (isMember() && changed().hasOnly(['lastMessage']))
      );
      allow delete: if signedIn() && isOrganizer();

      // US-11/12 : groupe de discussion de l'activité, réservé à ses membres.
      match /messages/{messageId} {
        function activity() { return get(/databases/$(database)/documents/activities/$(activityId)).data; }
        function inGroup() { return activity().organizerId == request.auth.uid || request.auth.uid in activity().participantIds; }
        allow read: if signedIn() && inGroup();
        allow create: if signedIn() && inGroup()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      }
    }

    // Messagerie privée (« Contact » du sujet ART) : une conversation par paire de membres,
    // d'identifiant « uidA__uidB » (uid triés). Seuls ses deux membres la lisent et y écrivent.
    match /privateChats/{chatId} {
      function inChat(data) { return request.auth.uid in data.memberIds; }
      function validLast(data) {
        return !('lastMessage' in data) || data.lastMessage == null || (data.lastMessage.authorId == request.auth.uid
          && data.lastMessage.text is string && data.lastMessage.text.size() > 0 && data.lastMessage.text.size() <= 1000);
      }
      function onlyMyRead(data, before) {
        return !('readAtMs' in data) || data.readAtMs.diff(before).affectedKeys().hasOnly([request.auth.uid]);
      }
      allow read: if signedIn() && inChat(resource.data);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberIds', 'lastMessage', 'readAtMs', 'updatedAtMs', 'activityId', 'activityTitle'])
        && request.resource.data.memberIds is list && request.resource.data.memberIds.size() == 2
        && inChat(request.resource.data)
        && request.resource.data.memberIds[0] < request.resource.data.memberIds[1]
        && chatId == request.resource.data.memberIds[0] + '__' + request.resource.data.memberIds[1]
        && validLast(request.resource.data) && onlyMyRead(request.resource.data, {});
      allow update: if signedIn() && inChat(resource.data)
        && changed().hasOnly(['lastMessage', 'readAtMs', 'updatedAtMs', 'activityId', 'activityTitle'])
        && (!('lastMessage' in changed()) || validLast(request.resource.data))
        && onlyMyRead(request.resource.data, resource.data.get('readAtMs', {}));

      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/privateChats/$(chatId)).data; }
        allow read: if signedIn() && request.auth.uid in chat().memberIds;
        allow create: if signedIn() && request.auth.uid in chat().memberIds
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      }
    }

    // Verrouillé par défaut — à ouvrir progressivement par collection
    // au fur et à mesure des User Stories (voir /specs/user-stories).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
