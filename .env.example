# Copier ce fichier en .env (jamais commité) et remplir les valeurs.

# Firebase Admin SDK
# Console Firebase > ⚙️ Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare
# dash.cloudflare.com/profile/api-tokens > Create Token
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Google Places API (géolocalisation / autocomplete adresse)
# console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=
