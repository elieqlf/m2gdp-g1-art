{
  "hosting": [
    {
      "target": "landing",
      "public": "landing",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "app",
      "public": "frontend/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "predeploy": [
        "npm --prefix \"$PROJECT_DIR/frontend\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "docs/firestore.rules",
    "indexes": "docs/firestore.indexes.json"
  },
  "database": {
    "rules": "docs/database.rules.json"
  }
}
