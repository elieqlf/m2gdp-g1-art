{
  "hosting": [
    {
      "target": "landing",
      "public": "landing",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "app",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ],
  "firestore": {
    "rules": "docs/firestore.rules",
    "indexes": "docs/firestore.indexes.json"
  },
  "database": {
    "rules": "docs/database.rules.json"
  }
}
